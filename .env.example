# ---- Vendor-risk service (local mock, started automatically when not running) ----
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001
# AUTO_START_MOCK_API=true        # set false to demo a real outage
# UI_PORT=8501

# ---- Model provider (only the single / staged architectures call a model; "rules" needs no key) ----
# Set ONE key below. The provider is detected from whichever key is present; LLM_PROVIDER is only
# needed when several keys are set. MODEL_NAME overrides the preset's default model.

# Anthropic (console.anthropic.com)         default model: claude-opus-5-5
ANTHROPIC_API_KEY=
# MODEL_EFFORT=medium              # optional: low | medium | high

# OpenAI (platform.openai.com)              default model: gpt-5-mini
# OPENAI_API_KEY=

# Google AI Studio, free tier (aistudio.google.com)   default model: gemini-3.1-flash-lite
# GEMINI_API_KEY=

# OpenRouter, free models (openrouter.ai/keys)        default model: nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_API_KEY=

# Any other OpenAI-compatible endpoint
# LLM_PROVIDER=openai_compatible
# OPENAI_COMPAT_BASE_URL=
# OPENAI_COMPAT_API_KEY=
# MODEL_NAME=

# Choose explicitly when more than one key is set: anthropic | openai | gemini | openrouter | openai_compatible
# LLM_PROVIDER=
